# Copy this file to .env and adjust if needed.
# These are the DEFAULT XAMPP MySQL settings.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=eskabirizi_db
# Set to true when connecting to Aiven or any managed MySQL host that requires SSL.
# Leave unset/false for local XAMPP.
DB_SSL=false

# Used to sign session cookies - change this to any random string
SESSION_SECRET=eskabirizi-super-secret-change-me

PORT=3000

# Cloudinary (photo storage) — get these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
